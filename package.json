{
  "name": "ultigrid-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "workspaces": [
    "packages/core",
    "packages/insight"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && npm run build:demo",
    "build:demo": "tsc -b && vite build",
    "build:packages": "npm run build:core && npm run build:insight",
    "build:core": "vite build --config packages/core/vite.config.ts && tsc -p packages/core/tsconfig.build.json",
    "build:insight": "vite build --config packages/insight/vite.config.ts && tsc -p packages/insight/tsconfig.build.json",
    "pack:packages": "node scripts/pack-packages.mjs",
    "publish:packages": "node scripts/publish-packages.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify:tarballs": "npm run pack:packages && node scripts/verify-packed-consumer.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint src tests packages --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:demo && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run check:size && npm run verify:packages && npm run verify:tarballs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-live": "^4.1.8",
    "sucrase": "^3.35.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "^0.8.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "glob": "10.5.0"
  }
}
